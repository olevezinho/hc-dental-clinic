@page "/clinical-cases/{Slug}"
@layout CustomLayout

<CustomAppBar />

@if (_clinicalCase is null)
{
    <section id="clinical-case-not-found">
        <div class="clinical-case-container">
            <h1 class="clinical-case-text">Caso clínico não encontrado</h1>
            <MudContainer MaxWidth="MaxWidth.Medium" Class="pa-4">
                <MudText 
                    Typo="Typo.h6" 
                    Class="mb-8"
                    Align="Align.Center"
                    Style="font-weight: 300; color: #807f7f;">
                    Pedimos desculpa, mas o caso clínico que procura não está disponível.
                </MudText>
                <MudButton
                    StartIcon="@Icons.Material.Filled.ArrowBack"
                    Href="clinical-cases"
                    Variant="Variant.Filled"
                    Style="color: white; background-color: #ad9587; border-radius: 24px; font-size: 1rem; padding: 0.75rem 2rem;">
                    Voltar
                </MudButton>
            </MudContainer>
        </div>
    </section>
}
else
{
    <PageTitle>@_clinicalCase.Title | HC Dental Clinic</PageTitle>
    <section id="clinical-case-detail">
        <div class="clinical-case-container">
            <h1 class="clinical-case-text">@_clinicalCase.Title</h1>
            <MudContainer MaxWidth="MaxWidth.Medium" Class="pa-4">
                @foreach (var paragraph in _clinicalCase.Paragraphs)
                {
                    <MudText 
                        Typo="Typo.body1" 
                        Class="pa-4 mb-4"
                        Style="font-weight: 300; color: #666666; font-size: 1.1rem; text-align: justify; text-justify: inter-word;">
                        @paragraph
                    </MudText>
                }
                <MudGrid Justify="Justify.Center" Spacing="4" Class="mt-8 mb-8">
                    @foreach (var image in _clinicalCase.Images)
                    {
                        <MudItem xs="12" sm="6" md="4" @key="image.Src">
                            <MudImage 
                                Src="@image.Src" 
                                Alt="@image.Alt"
                                Fluid="true"
                                Style="display: block; width: 100%; border-radius: 24px; box-shadow: 1px 1px 6px rgba(20, 20, 20, 0.1);" />
                        </MudItem>
                    }
                </MudGrid>
                <div class="d-flex justify-center mb-8">
                    <MudButton
                        Class="mt-20 mb-10"
                        StartIcon="@Icons.Material.Filled.ArrowBack"
                        Variant="Variant.Filled"
                        Href="clinical-cases"
                        Style="color: white; background-color: #b7b6b6; border-radius: 24px; font-size: 1.15rem; padding: 0.75rem 2rem; margin-right: 2rem;">
                        Voltar
                    </MudButton>
                    <MudButton
                        Class="mt-20 mb-10"
                        Variant="Variant.Filled"
                        Href="contact-request"
                        Style="color: white; background-color: #ad9587; border-radius: 24px; font-size: 1.15rem; padding: 0.75rem 2rem;">
                        Marcação
                    </MudButton>
                </div>
            </MudContainer>
        </div>
    </section>
}

<CustomPatientTestimonialsComponent />
<CustomFooter />
<CustomWhatsAppButton />
<CustomCookieConsent />

@code 
{
    [Parameter] 
    public string? Slug { get; set; }

    private ClinicalCase? _clinicalCase;

    protected override void OnParametersSet()
    {
        _clinicalCase = ClinicalCasesData.FindBySlug(Slug);
    }
}