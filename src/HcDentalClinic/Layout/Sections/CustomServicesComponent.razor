<section id="services">
    <MudBreakpointProvider OnBreakpointChanged="OnBreakpointChanged">
        @if(IsMobile)
        {
            <div class="services-container-mobile">
                <h1 class="services-text">Os nossos serviços</h1>
                <MudText 
                    Typo="Typo.h5"
                    Class="pa-12 mt-2"
                    Align="Align.Center"
                    Style="font-weight: 300; color: #807f7f; font-size: 1.1rem;">
                    Cuidados dentários abrangentes adaptados às suas necessidades
                </MudText>
                <MudGrid 
                    Class="pa-2 mt-2 mb-8"
                    Justify="Justify.Center" 
                    Spacing="8">
                    @foreach (var service in services)
                    {
                        <MudItem xs="10" sm="8">
                            @ServiceCard(service)
                        </MudItem>
                        <MudFlexBreak />
                    }
                </MudGrid>
            </div>
        }
        else if(IsSmallTablet || IsLargeTablet)
        {
            <div class="services-container-mobile">
                <h1 class="services-text">Os nossos serviços</h1>
                <MudText 
                    Typo="Typo.h5"
                    Class="pa-12 mt-2"
                    Align="Align.Center"
                    Style="font-weight: 300; color: #807f7f; font-size: 1.1rem;">
                    Cuidados dentários abrangentes adaptados às suas necessidades
                </MudText>
                <MudGrid 
                    Class="pa-2 mt-2 mb-8"
                    Justify="Justify.Center" 
                    Spacing="8">
                    @foreach (var service in services)
                    {
                        <MudItem sm="5" md="5" Class="d-flex">
                            @ServiceCard(service)
                        </MudItem>
                    }
                </MudGrid>
            </div>
        }
        else
        {
            <div class="services-container">
                <h1 class="services-text">Os nossos serviços</h1>
                <MudText 
                    Typo="Typo.h6"
                    Class="mt-1 mb-6"
                    Align="Align.Center"
                    Style="font-weight: 325; color: #807f7f; font-size: 1.3rem;">
                    Cuidados dentários abrangentes adaptados às suas necessidades
                </MudText>
                <MudGrid 
                    Class="pa-1 mt-4 mb-8"
                    Justify="Justify.Center" 
                    Spacing="8">
                    <MudItem xs="6" sm="3" Class="d-flex">
                        <MudPaper
                            @onmouseover="OnMouseOverYellowPlaceholderShadowIncrease"
                            @onmouseout="OnMouseOutYellowPlaceholderShadowDecrease"
                            Style="@($"background-color: #ffffff; border-radius: 24px; box-shadow: {defaultYellowPlaceholderShadow} text-shadow: 2px 2px 8px rgba(0, 0, 0, 0.25); width: 100%;")">
                            <MudGrid Class="pa-6">
                                <MudItem xs="12" Style="margin-bottom: -2rem;">
                                    <MudText Typo="Typo.h3" Class="pa-5" Align="Align.Center"
                                        Style="color: #ad9587; font-weight: bold;">
                                        Cirurgia Oral e Implantologia
                                    </MudText>
                                </MudItem>
                                <MudFlexBreak />
                                <MudItem xs="12">
                                    <MudText Typo="Typo.h6" Class="pa-5" Align="Align.Justify"
                                        Style="@($"color: {Colors.Gray.Darken1}; font-weight: 300;")">
                                        Tratamentos orientados para repor a função, o conforto e a confiança do seu sorriso.
                                        <ul style="list-style-type: disc; padding-left: 1.5rem;">
                                            <br/>
                                            <li>Cirurgia oral e implantologia</li>
                                            <li>Prótese fixa e removível</li>
                                        </ul>
                                    </MudText>
                                </MudItem>
                            </MudGrid>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="6" sm="3" Class="d-flex">
                        <MudPaper
                            @onmouseover="OnMouseOverBrownPlaceholderShadowIncrease"
                            @onmouseout="OnMouseOutBrownPlaceholderShadowDecrease"
                            Style="@($"background-color: #ffffff; border-radius: 24px; box-shadow: {defaultBrownPlaceholderShadow} text-shadow: 2px 2px 8px rgba(0, 0, 0, 0.25); width: 100%;")">
                            <MudGrid Class="pa-6">
                                <MudItem xs="12" Style="margin-bottom: -2rem;">
                                    <MudText Typo="Typo.h3" Class="pa-5" Align="Align.Center"
                                        Style="color: #ad9587; font-weight: bold;">
                                        Saúde Oral e Prevenção
                                    </MudText>
                                </MudItem>
                                <MudFlexBreak />
                                <MudItem xs="12">
                                    <MudText Typo="Typo.h6" Class="pa-5" Align="Align.Justify"
                                        Style="@($"color: {Colors.Gray.Darken1}; font-weight: 300;")">
                                        Acompanhamento clínico para prevenir problemas e cuidar da saúde dos dentes e gengivas.
                                        <ul style="list-style-type: disc; padding-left: 1.5rem;">
                                            <br/>
                                            <li>Higiene oral</li>
                                            <li>Periodontologia</li>
                                            <li>Endodontia</li>
                                        </ul>
                                    </MudText>
                                </MudItem>
                            </MudGrid>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="6" sm="3" Class="d-flex">
                        <MudPaper
                            @onmouseover="OnMouseOverPinkPlaceholderShadowIncrease"
                            @onmouseout="OnMouseOutPinkPlaceholderShadowDecrease"
                            Style="@($"background-color: #ffffff; border-radius: 24px; box-shadow: {defaultPinkPlaceholderShadow} text-shadow: 2px 2px 8px rgba(0, 0, 0, 0.25); width: 100%;")">
                            <MudGrid Class="pa-6">
                                <MudItem xs="12" Style="margin-bottom: -2rem;">
                                    <MudText Typo="Typo.h3" Class="pa-5" Align="Align.Center"
                                        Style="color: #ad9587; font-weight: bold;">
                                        Ortodontia e Reabilitação Oral
                                    </MudText>
                                </MudItem>
                                <MudFlexBreak />
                                <MudItem xs="12">
                                    <MudText Typo="Typo.h6" Class="pa-5" Align="Align.Justify"
                                        Style="@($"color: {Colors.Gray.Darken1}; font-weight: 300;")">
                                        Soluções personalizadas para melhorar o alinhamento, a mordida e a estética do sorriso.
                                        <ul style="list-style-type: disc; padding-left: 1.5rem;">
                                            <br/>
                                            <li>Reabilitação oral estética</li>
                                            <li>Ortodontia e alinhadores</li>
                                            <li>Oclusão e disfunção temporomandibular</li>
                                        </ul>
                                    </MudText>
                                </MudItem>
                            </MudGrid>
                        </MudPaper>
                    </MudItem>

                    <MudFlexBreak />

                    <MudItem xs="6" sm="3" Class="d-flex">
                        <MudPaper
                            @onmouseover="OnMouseOverPurplePlaceholderShadowIncrease"
                            @onmouseout="OnMouseOutPurplePlaceholderShadowDecrease"
                            Style="@($"background-color: #ffffff; border-radius: 24px; box-shadow: {defaultPurplePlaceholderShadow} text-shadow: 2px 2px 8px rgba(0, 0, 0, 0.25); width: 100%;")">
                            <MudGrid Class="pa-6">
                                <MudItem xs="12" Style="margin-bottom: -2rem;">
                                    <MudText Typo="Typo.h3" Class="pa-5" Align="Align.Center"
                                        Style="color: #ad9587; font-weight: bold;">
                                        Medicina Dentária Infantil
                                    </MudText>
                                </MudItem>
                                <MudFlexBreak />
                                <MudItem xs="12">
                                    <MudText Typo="Typo.h6" Class="pa-5" Align="Align.Justify"
                                        Style="@($"color: {Colors.Gray.Darken1}; font-weight: 300;")">
                                        Cuidados pensados para acompanhar o desenvolvimento oral das crianças com tranquilidade.
                                        <ul style="list-style-type: disc; padding-left: 1.5rem;">
                                            <br/>
                                            <li>Odontopediatria</li>
                                        </ul>
                                    </MudText>
                                </MudItem>
                            </MudGrid>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="6" sm="3" Class="d-flex">
                        <MudPaper
                            @onmouseover="OnMouseOverGreenPlaceholderShadowIncrease"
                            @onmouseout="OnMouseOutGreenPlaceholderShadowDecrease"
                            Style="@($"background-color: #ffffff; border-radius: 24px; box-shadow: {defaultGreenPlaceholderShadow} text-shadow: 2px 2px 8px rgba(0, 0, 0, 0.25); width: 100%;")">
                            <MudGrid Class="pa-6">
                                <MudItem xs="12" Style="margin-bottom: -2rem;">
                                    <MudText Typo="Typo.h3" Class="pa-5" Align="Align.Center"
                                        Style="color: #ad9587; font-weight: bold;">
                                        Medicina Estética Facial
                                    </MudText>
                                </MudItem>
                                <MudFlexBreak />
                                <MudItem xs="12">
                                    <MudText Typo="Typo.h6" Class="pa-5" Align="Align.Justify"
                                        Style="@($"color: {Colors.Gray.Darken1}; font-weight: 300;")">
                                        Tratamentos adaptados a cada pessoa, focados na harmonia e naturalidade facial.
                                        <ul style="list-style-type: disc; padding-left: 1.5rem;">
                                            <br/>
                                            <li>Bioestimuladores de colagénio</li>
                                            <li>Toxina botulínica</li>
                                            <li>Ácido hialurónico</li>
                                            <li>Plasma rico em plaquetas (PRP)</li>
                                            <li>NCTF 135 HA</li>
                                            <li>Peeling e Dermapen</li>
                                        </ul>
                                    </MudText>
                                </MudItem>
                            </MudGrid>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="6" sm="3" Class="d-flex">
                        <MudPaper
                            @onmouseover="OnMouseOverRedPlaceholderShadowIncrease"
                            @onmouseout="OnMouseOutRedPlaceholderShadowDecrease"
                            Style="@($"background-color: #ffffff; border-radius: 24px; box-shadow: {defaultRedPlaceholderShadow} text-shadow: 2px 2px 8px rgba(0, 0, 0, 0.25); width: 100%;")">
                            <MudGrid Class="pa-6">
                                <MudItem xs="12" Style="margin-bottom: -2rem;">
                                    <MudText Typo="Typo.h3" Class="pa-5" Align="Align.Center"
                                        Style="color: #ad9587; font-weight: bold;">
                                        Medicina Geral, Familiar e Gestão de Peso
                                    </MudText>
                                </MudItem>
                                <MudFlexBreak />
                                <MudItem xs="12">
                                    <MudText Typo="Typo.h6" Class="pa-5" Align="Align.Justify"
                                        Style="@($"color: {Colors.Gray.Darken1}; font-weight: 300;")">
                                        Acompanhamento médico próximo, com foco na saúde global e no bem-estar.
                                        <ul style="list-style-type: disc; padding-left: 1.5rem;">
                                            <br/>
                                            <li>Medicina geral e familiar</li>
                                            <li>Mesoterapia capilar</li>
                                            <li>Emagrecimento e obesidade</li>
                                        </ul>
                                    </MudText>
                                </MudItem>
                            </MudGrid>
                        </MudPaper>
                    </MudItem>
                </MudGrid>
            </div>
        }
    </MudBreakpointProvider>
    
</section>

@code 
{
    private MudBlazor.Breakpoint _currentBreakpoint;
    private bool IsMobile => _currentBreakpoint < MudBlazor.Breakpoint.Sm;
    private bool IsSmallTablet => _currentBreakpoint is MudBlazor.Breakpoint.Sm;
    private bool IsLargeTablet => _currentBreakpoint >= MudBlazor.Breakpoint.Md && _currentBreakpoint < MudBlazor.Breakpoint.Lg;

    private readonly record struct Service( string Title, string Description, string[] Treatments);

    private readonly Service[] services =
    [
        new("Cirurgia Oral e Implantologia", "Tratamentos orientados para repor a função, o conforto e a confiança do seu sorriso.", ["Cirurgia oral e implantologia", "Prótese fixa e removível"]),
        new("Saúde Oral e Prevenção", "Acompanhamento clínico para prevenir problemas e cuidar da saúde dos dentes e gengivas.", ["Higiene oral", "Periodontologia", "Endodontia"]),
        new("Ortodontia e Reabilitação Oral", "Soluções personalizadas para melhorar o alinhamento, a mordida e a estética do sorriso.", ["Reabilitação oral estética", "Ortodontia e alinhadores", "Oclusão e disfunção temporomandibular"]),
        new("Medicina Dentária Infantil", "Cuidados pensados para acompanhar o desenvolvimento oral das crianças com tranquilidade.", ["Odontopediatria"]),
        new("Medicina Estética Facial", "Tratamentos adaptados a cada pessoa, focados na harmonia e naturalidade facial.", ["Bioestimuladores de colagénio", "Toxina botulínica", "Ácido hialurónico", "Plasma rico em plaquetas (PRP)", "NCTF 135 HA", "Peeling", "Dermapen"]),
        new("Medicina Geral, Familiar e Gestão de Peso", "Acompanhamento médico próximo, com foco na saúde global e no bem-estar.", ["Medicina geral e familiar", "Mesoterapia capilar", "Emagrecimento e obesidade"])
    ];

    private RenderFragment ServiceCard(Service service) => 
    @<MudPaper
        @onmouseover="OnMouseOverBrownPlaceholderShadowIncrease"
        @onmouseout="OnMouseOutBrownPlaceholderShadowDecrease"
        Style="@($"background-color: #ffffff; border-radius: 24px; box-shadow: {defaultBrownPlaceholderShadow} text-shadow: 2px 2px 8px rgba(0, 0, 0, 0.25); width: 100%;")">
        <MudGrid Class="pa-2 mt-1">
            <MudFlexBreak />
            <MudItem xs="12" Style="margin-bottom: -2rem;">
                <MudText Typo="Typo.h3" Class="pa-5" Align="Align.Left" Style="@($"color: {Colors.Gray.Darken3}; font-weight: bold;")">
                    @service.Title
                </MudText>
            </MudItem>
            <MudFlexBreak />
            <MudItem xs="12">
                <MudText Typo="Typo.h6" Class="pa-5" Align="Align.Left" Style="@($"color: {Colors.Gray.Darken1}; font-weight: 250;")">
                    @service.Description
                    <ul style="list-style-type: disc; padding-left: 1.5rem;">
                        @foreach (var treatment in service.Treatments)
                        {
                            <li>@treatment</li>
                        }
                    </ul>
                </MudText>
            </MudItem>
        </MudGrid>
    </MudPaper>;

    private string defaultYellowPlaceholderShadow = "0px 0px 8px rgba(20, 20, 20, 0.15);";
    private string defaultBrownPlaceholderShadow = "0px 0px 8px rgba(20, 20, 20, 0.15);";
    private string defaultPinkPlaceholderShadow = "0px 0px 8px rgba(20, 20, 20, 0.15);";
    private string defaultPurplePlaceholderShadow = "0px 0px 8px rgba(20, 20, 20, 0.15);";
    private string defaultGreenPlaceholderShadow = "0px 0px 8px rgba(20, 20, 20, 0.15);";
    private string defaultRedPlaceholderShadow = "0px 0px 8px rgba(20, 20, 20, 0.15);";

    private void OnBreakpointChanged(MudBlazor.Breakpoint breakpoint)
    {
        _currentBreakpoint = breakpoint;
        StateHasChanged();
    }
    
    private void OnMouseOverYellowPlaceholderShadowIncrease(MouseEventArgs args)
    {
        defaultYellowPlaceholderShadow = "0px 4px 16px rgba(20, 20, 20, 0.25);";
    }

    private void OnMouseOutYellowPlaceholderShadowDecrease(MouseEventArgs args)
    {
        defaultYellowPlaceholderShadow = "0px 0px 8px rgba(20, 20, 20, 0.15);";
    }

    private void OnMouseOverBrownPlaceholderShadowIncrease(MouseEventArgs args)
    {
        defaultBrownPlaceholderShadow = "0px 4px 16px rgba(20, 20, 20, 0.25);";
    }

    private void OnMouseOutBrownPlaceholderShadowDecrease(MouseEventArgs args)
    {
        defaultBrownPlaceholderShadow = "0px 0px 8px rgba(20, 20, 20, 0.15);";
    }

    private void OnMouseOverPinkPlaceholderShadowIncrease(MouseEventArgs args)
    {
        defaultPinkPlaceholderShadow = "0px 4px 16px rgba(20, 20, 20, 0.25);";
    }

    private void OnMouseOutPinkPlaceholderShadowDecrease(MouseEventArgs args)
    {
        defaultPinkPlaceholderShadow = "0px 0px 8px rgba(20, 20, 20, 0.15);";
    }

    private void OnMouseOverPurplePlaceholderShadowIncrease(MouseEventArgs args)
    {
        defaultPurplePlaceholderShadow = "0px 4px 16px rgba(20, 20, 20, 0.25);";
    }

    private void OnMouseOutPurplePlaceholderShadowDecrease(MouseEventArgs args)
    {
        defaultPurplePlaceholderShadow = "0px 0px 8px rgba(20, 20, 20, 0.15);";
    }

    private void OnMouseOverGreenPlaceholderShadowIncrease(MouseEventArgs args)
    {
        defaultGreenPlaceholderShadow = "0px 4px 16px rgba(20, 20, 20, 0.25);";
    }

    private void OnMouseOutGreenPlaceholderShadowDecrease(MouseEventArgs args)
    {
        defaultGreenPlaceholderShadow = "0px 0px 8px rgba(20, 20, 20, 0.15);";
    }

    private void OnMouseOverRedPlaceholderShadowIncrease(MouseEventArgs args)
    {
        defaultRedPlaceholderShadow = "0px 4px 16px rgba(20, 20, 20, 0.25);";
    }

    private void OnMouseOutRedPlaceholderShadowDecrease(MouseEventArgs args)
    {
        defaultRedPlaceholderShadow = "0px 0px 8px rgba(20, 20, 20, 0.15);";
    }
}