<section id="clinic">
    <MudBreakpointProvider OnBreakpointChanged="OnBreakpointChanged">
        @if(IsMobile || IsSmallTablet || IsLargeTablet)
        {
            <div class="clinic-container-mobile">
                <h1 class="clinic-text">O nosso espaço</h1>
                <MudContainer>
                    <MudCarousel 
                        Class="@CarouselClass" 
                        Style="@($"height: {CarouselHeight};")"
                        AutoCycle="true" 
                        ShowBullets="false"
                        ShowArrows="false"
                        TData="object">
                        <ChildContent>
                            <MudCarouselItem Color="@Color.Inherit" Transition="Transition.Fade">
                                <div class="carousel-static">
                                    <ClinicCarouselSlide 
                                        Headline="Onde os sorrisos crescem a brincar"
                                        Body="Um espaço pensado para os mais pequenos, onde cada visita ao dentista é uma nova aventura. Venha descobrir o nosso mundo."
                                        ImageSrc="images/clinic/kids-playground.webp"
                                        ImageAlt="Espaço infantil da HC Dental Clinic"
                                        Stacked="true" />
                                </div>
                            </MudCarouselItem>
                            <MudCarouselItem Color="@Color.Inherit" Transition="Transition.Fade">
                                <div class="carousel-static">
                                    <ClinicCarouselSlide 
                                        Headline="O conforto começa à entrada"
                                        Body="Um átrio luminoso e acolhedor, com música ambiente, pensado para o receber com calma desde o primeiro momento."
                                        ImageSrc="images/clinic/attrium.webp"
                                        ImageAlt="Átrio da HC Dental Clinic"
                                        Stacked="true" />
                                </div>
                            </MudCarouselItem>
                            <MudCarouselItem Color="@Color.Inherit" Transition="Transition.Fade">
                                <div class="carousel-static">
                                    <ClinicCarouselSlide 
                                        Headline="Tecnologia ao serviço do seu sorriso"
                                        Body="Consultórios modernos e totalmente equipados, para tratamentos mais precisos, confortáveis e seguros."
                                        ImageSrc="images/clinic/office-zoomed.webp"
                                        ImageAlt="Consultório da HC Dental Clinic"
                                        Stacked="true" />
                                </div>
                            </MudCarouselItem>
                        </ChildContent>
                    </MudCarousel>
                </MudContainer>
            </div>
        }
        else
        {
            <div class="clinic-container">
                <h1 class="clinic-text">O nosso espaço</h1>
                <MudContainer>
                    <MudCarousel 
                        Class="mud-width-full pa-10 mt-50" 
                        Style="height: 60svh;" 
                        AutoCycle="true" 
                        ShowBullets="false"
                        ShowArrows="false"
                        TData="object">
                        <ChildContent>
                            <MudCarouselItem Color="@Color.Inherit" Transition="Transition.Fade">
                                <div class="carousel-static carousel-static-desktop">
                                    <ClinicCarouselSlide 
                                        Headline="Onde os sorrisos crescem a brincar"
                                        Body="Um espaço pensado para os mais pequenos, onde cada visita ao dentista é uma nova aventura. Marque a primeira consulta e venha descobrir o nosso mundo."
                                        ImageSrc="images/clinic/kids-playground.webp"
                                        ImageAlt="Espaço infantil da HC Dental Clinic"
                                        ImageFirst="true" />
                                </div>
                            </MudCarouselItem>
                            <MudCarouselItem Color="@Color.Inherit" Transition="Transition.Fade">
                                <div class="carousel-static carousel-static-desktop">
                                    <ClinicCarouselSlide 
                                        Headline="O conforto começa à entrada"
                                        Body="Um átrio luminoso e acolhedor, com música ambiente, pensado para o receber com calma desde o primeiro momento."
                                        ImageSrc="images/clinic/attrium.webp"
                                        ImageAlt="Átrio da HC Dental Clinic" />
                                </div>
                            </MudCarouselItem>
                            <MudCarouselItem Color="@Color.Inherit" Transition="Transition.Fade">
                                <div class="carousel-static carousel-static-desktop">
                                    <ClinicCarouselSlide 
                                        Headline="Tecnologia ao serviço do seu sorriso"
                                        Body="Consultórios modernos e totalmente equipados, para tratamentos mais precisos, confortáveis e seguros."
                                        ImageSrc="images/clinic/office-zoomed.webp"
                                        ImageAlt="Consultório da HC Dental Clinic" 
                                        ImageFirst="true" />
                                </div>
                            </MudCarouselItem>
                        </ChildContent>
                    </MudCarousel>
                </MudContainer>
            </div>
        }
    </MudBreakpointProvider>
</section>

@code 
{
    private MudBlazor.Breakpoint _currentBreakpoint;
    private bool IsMobile => _currentBreakpoint < MudBlazor.Breakpoint.Sm;
    private bool IsSmallTablet => _currentBreakpoint is MudBlazor.Breakpoint.Sm;
    private bool IsLargeTablet => _currentBreakpoint >= MudBlazor.Breakpoint.Md && _currentBreakpoint < MudBlazor.Breakpoint.Lg;

    // Per-breakpoint carousel sizing: mobile needs a tall frame because the
    // slide content stacks; tablets approach desktop proportions.
    private string CarouselHeight => _currentBreakpoint switch
    {
        < MudBlazor.Breakpoint.Sm => "clamp(30rem, 78svh, 38rem)",
        MudBlazor.Breakpoint.Sm => "clamp(28rem, 68svh, 34rem)",
        _ => "clamp(26rem, 58svh, 32rem)" // LargeTablet
    };

    private string CarouselClass => _currentBreakpoint switch
    {
        < MudBlazor.Breakpoint.Sm => "mud-width-full pa-2 mt-4",
        MudBlazor.Breakpoint.Sm => "mud-width-full pa-4 mt-6",
        _ => "mud-width-full pa-6 mt-8" // LargeTablet
    };
    
    private void OnBreakpointChanged(MudBlazor.Breakpoint breakpoint)
    {
        _currentBreakpoint = breakpoint;
        StateHasChanged();
    }
}