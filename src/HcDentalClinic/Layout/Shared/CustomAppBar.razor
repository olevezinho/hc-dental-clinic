<MudBreakpointProvider OnBreakpointChanged="OnBreakpointChanged">
    <MudToolBar Style="position: sticky; top: 0; width: 100%; z-index: 999999; background-color: black;">
        <MudImage 
            @onclick="@(() => Navigation.NavigateTo("/"))" 
            Src="/images/loading-light.webp" 
            Alt="HC Dental Clinic logótipo" 
            Width="190" />
        <MudSpacer />
        @if(IsMobile || IsSmallTablet)
        {
            <MudIconButton
                Class="mr-2"
                Icon="@Icons.Material.Rounded.Menu"
                aria-label="Abrir menu"
                OnClick="OpenMobileMenu"
                Style="@($"color: #ffffff; background-color: {mudContactButtonBackgroundColor}; border-radius: 16px;")" />
        }
        else
        {
            <MudMenu 
                Class="mr-5"
                @onmouseover="OnMouseOverTextAboutUsColorChange"
                @onmouseout="OnMouseOutTextAboutUsColorChange"
                @onclick="OnMouseClickAboutUsChange"
                ActivationEvent="MouseEvent.MouseOver"
                Variant="Variant.Text"
                EndIcon="@($"{mudAboutUsIcon}")"
                Label="Sobre nós"
                Style="@($"color: {mudAboutUsTextColor}; transition: color 0.3s;")">
                <MudMenuItem 
                    @onmouseover="OnMouseOverTextWhoWeAreColorChange"
                    @onmouseout="OnMouseOutTextWhoWeAreColorChange" 
                    OnClick="@(() => Navigation.NavigateTo("values#about-us"))"
                    Label="Quem somos"
                    Style="@($"color: {mudWhoWeAreTextColor}; transition: color 0.3s; background-color: {mudWhoWeAreTextBackgroundColor};")"/>
                <MudMenuItem
                    @onmouseover="OnMouseOverTextPhilosophyColorChange"
                    @onmouseout="OnMouseOutTextPhilosophyColorChange"
                    OnClick="@(() => Navigation.NavigateTo("values#philosophy"))"
                    Label="Filosofia" 
                    Style="@($"color: {mudPhilosophyTextColor}; transition: color 0.3s; background-color: {mudPhilosophyTextBackgroundColor};")"/>
            </MudMenu>
            <MudButton 
                Class="mr-5"
                Variant="Variant.Text"
                Href="#services"
                @onmouseover="OnMouseOverTextServicosColorChange"
                @onmouseout="OnMouseOutTextServicosColorChange"
                OnClick="@(async () => await ScrollToSection("services"))"
                Style="@($"color: {mudServicosTextColor}; transition: color 0.3s;")">
                Serviços
            </MudButton>
            <MudButton 
                Class="mr-5"
                Variant="Variant.Text"
                Href="team"
                @onmouseover="OnMouseOverTextEquipaColorChange"
                @onmouseout="OnMouseOutTextEquipaColorChange"
                Style="@($"color: {mudEquipaTextColor}; transition: color 0.3s;")">
                Equipa
            </MudButton>
            <MudButton 
                Class="mr-5"
                Variant="Variant.Text"
                Href="clinical-cases"
                @onmouseover="OnMouseOverTextCasosClinicosColorChange"
                @onmouseout="OnMouseOutTextCasosClinicosColorChange"
                Style="@($"color: {mudCasosClinicosTextColor}; transition: color 0.3s;")">
                Casos Clínicos
            </MudButton>
            <MudButton 
                Class="mr-5"
                Variant="Variant.Text"
                Href="#contact-form"
                @onmouseover="OnMouseOverTextMarcacaoColorChange"
                @onmouseout="OnMouseOutTextMarcacaoColorChange"
                OnClick="@(async () => await ScrollToSection("contact-form"))"
                Style="@($"color: {mudMarcacaoTextColor}; transition: color 0.3s;")">
                Marcação
            </MudButton>
            @* TODO: Adicionar botão para hc-mini *@
            <MudButton 
                Class="mr-5"
                Variant="Variant.Filled"
                Href="#footer"
                @onmouseover="OnMouseOverContactColorChange"
                @onmouseout="OnMouseOutContactColorChange"
                OnClick="@(async () => await ScrollToSection("footer"))"
                Style="@($"color: {mudContactButtonTextColor}; background-color: {mudContactButtonBackgroundColor}; border-radius: 16px;")">
                Contacto
            </MudButton>
        }
    </MudToolBar>

    <div class="mobile-menu @(_mobileMenuOpen ? "open" : null)">
        <div class="mobile-menu-backdrop" @onclick="CloseMobileMenu"></div>
        <aside class="mobile-menu-panel">
            <div class="mobile-menu-header">
                <MudIconButton
                    Icon="@Icons.Material.Rounded.Close"
                    aria-label="Fechar menu"
                    OnClick="CloseMobileMenu"
                    Style="@($"color: {Colors.Shades.White};")" />
            </div>
            <nav class="mobile-menu-nav">
                <button type="button" class="mobile-menu-link" @onclick="ToggleAboutUs">
                    Sobre nós
                    <MudIcon
                        Icon="@Icons.Material.Rounded.ExpandMore"
                        Size="Size.Small"
                        Style="@($"transition: transform 0.25s ease; transform: rotate({(_aboutUsExpanded ? "180deg" : "0deg")});")" />
                </button>
                <div class="mobile-menu-submenu @(_aboutUsExpanded ? "expanded" : null)">
                    <div class="mobile-menu-submenu-inner">
                        <button type="button" class="mobile-menu-link mobile-menu-sublink"
                            @onclick="@(() => NavigateAndClose("values#about-us"))">
                            Quem somos
                        </button>
                        <button type="button" class="mobile-menu-link mobile-menu-sublink"
                            @onclick="@(() => NavigateAndClose("values#philosophy"))">
                            Filosofia
                        </button>
                    </div>
                </div>
                <button type="button" class="mobile-menu-link"
                    @onclick="@(() => NavigateAndClose("team"))">
                    Equipa
                </button>
                <button type="button" class="mobile-menu-link"
                    @onclick="@(() => NavigateAndClose("clinical-cases"))">
                    Casos Clínicos
                </button>
                <button type="button" class="mobile-menu-link"
                    @onclick="@(() => NavigateAndClose("contact-request"))">
                    Marcação
                </button>
                <button type="button" class="mobile-menu-link" @onclick="ScrollToFooterAndClose">
                    Contacto
                </button>
            </nav>
        </aside>
    </div>
</MudBreakpointProvider>

@code
{
    private MudBlazor.Breakpoint _currentBreakpoint;
    private bool IsMobile => _currentBreakpoint < MudBlazor.Breakpoint.Sm;
    private bool IsSmallTablet => _currentBreakpoint is MudBlazor.Breakpoint.Sm;

    private bool _mobileMenuOpen;
    private bool _aboutUsExpanded;

    private string mudAboutUsTextColor = Colors.Gray.Lighten5;
    private string mudWhoWeAreTextColor = Colors.Gray.Lighten5;
    private string mudWhoWeAreTextBackgroundColor = Colors.Shades.Black;
    private string mudPhilosophyTextColor = Colors.Gray.Lighten5;
    private string mudPhilosophyTextBackgroundColor = Colors.Shades.Black;
    private string mudAboutUsIcon = Icons.Material.Rounded.ArrowDropDown;
    private string mudServicosTextColor = Colors.Gray.Lighten5;
    private string mudEquipaTextColor = Colors.Gray.Lighten5;
    private string mudCasosClinicosTextColor = Colors.Gray.Lighten5;
    private string mudMarcacaoTextColor = Colors.Gray.Lighten5;
    private string mudContactButtonTextColor = Colors.Shades.White;
    private string mudContactButtonBackgroundColor = Colors.BlueGray.Darken4;

    private async Task OnBreakpointChanged(MudBlazor.Breakpoint breakpoint)
    {
        _currentBreakpoint = breakpoint;
        await CloseMobileMenu();
        StateHasChanged();
    }

    // Scroll to section using JavaScript interop
    private async Task ScrollToSection(string sectionId)
    {
        await JSRuntime.InvokeVoidAsync("scrollToSection", sectionId);
    }

    private async Task OpenMobileMenu()
    {
        _mobileMenuOpen = true;
        await JSRuntime.InvokeVoidAsync("setBodyScrollLock", true);
    }

    private async Task CloseMobileMenu()
    {
        if(!_mobileMenuOpen)
        {
            return;
        }

        _mobileMenuOpen = false;
        _aboutUsExpanded = false;
        await JSRuntime.InvokeVoidAsync("setBodyScrollLock", false);
    }

    private void ToggleAboutUs()
    {
        _aboutUsExpanded = !_aboutUsExpanded;
    }

    private async Task NavigateAndClose(string uri)
    {
        await CloseMobileMenu();
        Navigation.NavigateTo(uri);
    }

    private async Task ScrollToFooterAndClose()
    {
        await CloseMobileMenu();
        await ScrollToSection("footer");
    }

    private void OnMouseOverTextAboutUsColorChange(MouseEventArgs args)
    {
        mudAboutUsTextColor = Colors.Brown.Lighten4;
    }

    private void OnMouseOutTextAboutUsColorChange(MouseEventArgs args)
    {
        mudAboutUsTextColor = Colors.Gray.Lighten5;
    }

    private void OnMouseClickAboutUsChange()
    {
        if(mudAboutUsIcon is not Icons.Material.Rounded.ArrowDropDown)
        {
            mudAboutUsIcon = Icons.Material.Rounded.ArrowDropDown;
        }
        else
        {
            mudAboutUsIcon = Icons.Material.Rounded.ArrowDropUp;    
        }        
    }

    private void OnMouseOverTextWhoWeAreColorChange(MouseEventArgs args)
    {
        mudWhoWeAreTextBackgroundColor = Colors.Gray.Darken4;
    }

    private void OnMouseOutTextWhoWeAreColorChange(MouseEventArgs args)
    {
        mudWhoWeAreTextBackgroundColor = Colors.Shades.Black;
    }

    private void OnMouseOverTextPhilosophyColorChange(MouseEventArgs args)
    {
        mudPhilosophyTextBackgroundColor = Colors.Gray.Darken4;
    }

    private void OnMouseOutTextPhilosophyColorChange(MouseEventArgs args)
    {
        mudPhilosophyTextBackgroundColor = Colors.Shades.Black;
    }

    private void OnMouseOverTextServicosColorChange(MouseEventArgs args)
    {
        mudServicosTextColor = Colors.Brown.Lighten4;
    }

    private void OnMouseOutTextServicosColorChange(MouseEventArgs args)
    {
        mudServicosTextColor = Colors.Gray.Lighten5;
    }

    private void OnMouseOverTextCasosClinicosColorChange(MouseEventArgs args)
    {
        mudCasosClinicosTextColor = Colors.Brown.Lighten4;
    }

    private void OnMouseOutTextCasosClinicosColorChange(MouseEventArgs args)
    {
        mudCasosClinicosTextColor = Colors.Gray.Lighten5;
    }

    private void OnMouseOverTextEquipaColorChange(MouseEventArgs args)
    {
        mudEquipaTextColor = Colors.Brown.Lighten4;
    }

    private void OnMouseOutTextEquipaColorChange(MouseEventArgs args)
    {
        mudEquipaTextColor = Colors.Gray.Lighten5;
    }

    private void OnMouseOverTextMarcacaoColorChange(MouseEventArgs args)
    {
        mudMarcacaoTextColor = Colors.Brown.Lighten4;
    }

    private void OnMouseOutTextMarcacaoColorChange(MouseEventArgs args)
    {
        mudMarcacaoTextColor = Colors.Gray.Lighten5;
    }

    private void OnMouseOverContactColorChange(MouseEventArgs args)
    {
        mudContactButtonTextColor = Colors.Gray.Lighten3;
        mudContactButtonBackgroundColor = "#ad9587";
    }

    private void OnMouseOutContactColorChange(MouseEventArgs args)
    {
        mudContactButtonTextColor = Colors.Shades.White;
        mudContactButtonBackgroundColor = Colors.BlueGray.Darken4;
    }
}
