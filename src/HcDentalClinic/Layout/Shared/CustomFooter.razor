<section id="footer">
    <MudPaper>
        <MudBreakpointProvider OnBreakpointChanged="OnBreakpointChanged">
            <div class="footer-container">
                <div style="@FrameStyle">
                    <MudGrid Class="@(IsMobile ? "px-4 pt-8 pb-4" : "px-4 py-10")" Justify="Justify.Center" Spacing="2">
                        <!-- Brand & social -->
                        <MudItem xs="10" sm="6" lg="3" Class="@(IsMobile ? "d-flex flex-column align-center" : null)">
                            <MudImage
                                Class="pa-2"
                                Src="/images/loading-light.webp"
                                Alt="HC Dental Clinic logótipo"
                                loading="lazy"
                                Width="240" />
                            <h2 class="footer-column-title">Conecte-se connosco</h2>
                            <div class="footer-social">
                                <MudIconButton
                                    Variant="Variant.Filled"
                                    @onmouseover="OnMouseOverFacebook"
                                    @onmouseout="OnMouseOutFacebook"
                                    Icon="@Icons.Custom.Brands.Facebook"
                                    Style="@($"color: {Colors.Gray.Lighten3}; background-color: {mudButtonFacebookBackgroundColor}; border-radius: 16px;")"
                                    Href="https://www.facebook.com/people/HC-Dental-Clinic/61552189786199/#" />
                                <MudIconButton
                                    Variant="Variant.Filled"
                                    @onmouseover="OnMouseOverInstagram"
                                    @onmouseout="OnMouseOutInstagram"
                                    Icon="@Icons.Custom.Brands.Instagram"
                                    Style="@($"color: {Colors.Gray.Lighten3}; background-color: {mudButtonInstagramBackgroundColor}; border-radius: 16px;")"
                                    Href="https://www.instagram.com/hcdentalclinic.pt/" />
                                <MudIconButton
                                    Variant="Variant.Filled"
                                    @onmouseover="OnMouseOverWhatsApp"
                                    @onmouseout="OnMouseOutWhatsApp"
                                    Icon="@Icons.Custom.Brands.WhatsApp"
                                    Style="@($"color: {Colors.Gray.Lighten3}; background-color: {mudButtonWhatsAppBackgroundColor}; border-radius: 16px;")"
                                    Href="https://wa.me/351965345367" />
                            </div>
                            <MudText Typo="Typo.h6" Class="pa-4"
                                Style="@($"color: {Colors.Gray.Lighten1}; font-weight: 250; text-align: {(IsMobile ? "center" : "left")};")">
                                Siga-nos para dicas dentárias, ofertas especiais e novidades da clínica!
                            </MudText>
                        </MudItem>

                        <!-- Quick links -->
                        <MudItem xs="10" sm="6" lg="3">
                            <MudText Typo="Typo.h5" Class="pa-4"
                                Style="@($"color: {Colors.Gray.Lighten3}; font-weight: bold;")">
                                Links Rápidos:
                            </MudText>
                            <MudButton
                                Class="ma-2"
                                Variant="Variant.Text"
                                Href="#clinic"
                                OnClick="@(async () => await ScrollToSection("clinic"))"
                                @onmouseover="OnMouseOverTextClinicaColorChange"
                                @onmouseout="OnMouseOutTextClinicaColorChange"
                                Style="@($"color: {mudClinicaTextColor}; font-weight: 250;")">
                                A clínica
                            </MudButton>
                            <MudFlexBreak />
                            <MudButton
                                Class="ma-2"
                                Variant="Variant.Text"
                                Href="#services"
                                OnClick="@(async () => await ScrollToSection("services"))"
                                @onmouseover="OnMouseOverTextServicosColorChange"
                                @onmouseout="OnMouseOutTextServicosColorChange"
                                Style="@($"color: {mudServicosTextColor}; font-weight: 250;")">
                                Serviços
                            </MudButton>
                            <MudFlexBreak />
                            <MudButton
                                Class="ma-2"
                                Variant="Variant.Text"
                                Href="#team"
                                OnClick="@(async () => await ScrollToSection("team"))"
                                @onmouseover="OnMouseOverTextEquipaColorChange"
                                @onmouseout="OnMouseOutTextEquipaColorChange"
                                Style="@($"color: {mudEquipaTextColor}; font-weight: 250;")">
                                A nossa equipa
                            </MudButton>
                            <MudFlexBreak />
                            <MudButton
                                Class="ma-2"
                                Variant="Variant.Text"
                                Href="#contact-form"
                                OnClick="@(async () => await ScrollToSection("contact-form"))"
                                @onmouseover="OnMouseOverTextContactosColorChange"
                                @onmouseout="OnMouseOutTextContactosColorChange"
                                Style="@($"color: {mudContactosTextColor}; font-weight: 250;")">
                                Contacte-nos
                            </MudButton>
                        </MudItem>

                        <!-- Contacts (moved from the retired contacts section) -->
                        <MudItem xs="10" sm="6" lg="3">
                            <h2 class="footer-column-title">Contactos</h2>
                            <div class="footer-contact-group">
                                <p class="footer-contact-label">Atendimento</p>
                                <a class="footer-contact-link" href="tel:+351255336369">+351 255 336 369</a><br />
                                <a class="footer-contact-link" href="tel:+351965345367">+351 965 345 367</a>
                            </div>
                            <div class="footer-contact-group">
                                <p class="footer-contact-label">Geral</p>
                                <a class="footer-contact-link" href="mailto:geral@hcdentalclinic.pt">geral@hcdentalclinic.pt</a>
                            </div>
                            <div class="footer-contact-group">
                                <p class="footer-contact-label">Marcações</p>
                                <a class="footer-contact-link" href="mailto:agendamentos@hcdentalclinic.pt">agendamentos@hcdentalclinic.pt</a>
                            </div>
                        </MudItem>

                        <!-- Schedule (moved from the retired contacts section) -->
                        <MudItem xs="10" sm="6" lg="3">
                            <h2 class="footer-column-title">Horário</h2>
                            <div class="footer-contact-group">
                                <p class="footer-contact-label">Segunda a Sexta</p>
                                <p class="footer-contact-value">09:00 - 12:30 / 14:00 - 19:30</p>
                            </div>
                            <div class="footer-contact-group">
                                <p class="footer-contact-label">Sábado</p>
                                <p class="footer-contact-value">09:00 - 13:00</p>
                            </div>
                            <br />
                            <div class="footer-contact-group">
                                <p class="footer-contact-value">ERS: 180687</p>
                                <p class="footer-contact-value">Licença: 26865/2026</p>
                            </div>
                        </MudItem>

                        <MudItem xs="12">
                            <MudDivider DividerType="DividerType.Middle" Class="my-6"
                                Style="@($"color: {Colors.Gray.Darken1};")" />
                        </MudItem>
                        <MudItem xs="10">
                            <div class="copyright-container">
                                <footer class="copyright-text">
                                    &copy; @DateTime.Now.Year HC Dental Clinic - Todos os direitos reservados.
                                </footer>
                            </div>
                        </MudItem>
                    </MudGrid>
                </div>
            </div>
        </MudBreakpointProvider>
    </MudPaper>
</section>

@code 
{
    private MudBlazor.Breakpoint _currentBreakpoint;
    private bool IsMobile => _currentBreakpoint < MudBlazor.Breakpoint.Sm;

    // Caps and centers the content so both edges keep generous margins
    // that scale with the viewport, without @media queries.
    private string FrameStyle => IsMobile
        ? "width: 92%; margin-inline: auto;"
        : "width: min(82%, 80rem); margin-inline: auto;";

    // Text link colors
    private string mudClinicaTextColor = Colors.Gray.Lighten1;
    private string mudServicosTextColor = Colors.Gray.Lighten1;
    private string mudEquipaTextColor = Colors.Gray.Lighten1;
    private string mudContactosTextColor = Colors.Gray.Lighten1;

    // Social media button background colors
    private string mudButtonFacebookBackgroundColor = Colors.BlueGray.Darken4;
    private string mudButtonInstagramBackgroundColor = Colors.BlueGray.Darken4;
    private string mudButtonWhatsAppBackgroundColor = Colors.BlueGray.Darken4;

    private void OnBreakpointChanged(MudBlazor.Breakpoint breakpoint)
    {
        _currentBreakpoint = breakpoint;
        StateHasChanged();
    }

    private async Task ScrollToSection(string sectionId)
    {
        await JSRuntime.InvokeVoidAsync("scrollToSection", sectionId);
    }

    private void OnMouseOverTextClinicaColorChange(MouseEventArgs args) => mudClinicaTextColor = Colors.Gray.Lighten3;
    private void OnMouseOutTextClinicaColorChange(MouseEventArgs args) => mudClinicaTextColor = Colors.Gray.Lighten1;

    private void OnMouseOverTextServicosColorChange(MouseEventArgs args) => mudServicosTextColor = Colors.Gray.Lighten3;
    private void OnMouseOutTextServicosColorChange(MouseEventArgs args) => mudServicosTextColor = Colors.Gray.Lighten1;

    private void OnMouseOverTextEquipaColorChange(MouseEventArgs args) => mudEquipaTextColor = Colors.Gray.Lighten3;
    private void OnMouseOutTextEquipaColorChange(MouseEventArgs args) => mudEquipaTextColor = Colors.Gray.Lighten1;

    private void OnMouseOverTextContactosColorChange(MouseEventArgs args) => mudContactosTextColor = Colors.Gray.Lighten3;
    private void OnMouseOutTextContactosColorChange(MouseEventArgs args) => mudContactosTextColor = Colors.Gray.Lighten1;

    private void OnMouseOverFacebook(MouseEventArgs args) => mudButtonFacebookBackgroundColor = "#ad9587";
    private void OnMouseOutFacebook(MouseEventArgs args) => mudButtonFacebookBackgroundColor = Colors.BlueGray.Darken4;

    private void OnMouseOverInstagram(MouseEventArgs args) => mudButtonInstagramBackgroundColor = "#ad9587";
    private void OnMouseOutInstagram(MouseEventArgs args) => mudButtonInstagramBackgroundColor = Colors.BlueGray.Darken4;

    private void OnMouseOverWhatsApp(MouseEventArgs args) => mudButtonWhatsAppBackgroundColor = "#ad9587";
    private void OnMouseOutWhatsApp(MouseEventArgs args) => mudButtonWhatsAppBackgroundColor = Colors.BlueGray.Darken4;
}
